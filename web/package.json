{
  "name": "badge-squirt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web Bluetooth uploader for the DZBJ- digital badge (no bundler, Web Components)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "serve": "serve -l 8080 .",
    "dev": "npm run build && npm run serve"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/web-bluetooth": "^0.0.21",
    "serve": "^14.2.4",
    "typescript": "^5.6.0"
  }
}
